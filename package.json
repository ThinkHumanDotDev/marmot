{
  "name": "marmot",
  "version": "0.0.0",
  "description": "Self-hosted status monitor with Uptime Kuma's monitoring and kan.bn's team workspaces, built on Payload CMS.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThinkHumanDotDev/marmot"
  },
  "scripts": {
    "dev": "concurrently -n web,worker,realtime -c blue,green,magenta \"pnpm dev:web\" \"pnpm dev:worker\" \"pnpm dev:realtime\"",
    "dev:web": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:worker": "cross-env NODE_OPTIONS=--no-deprecation node scripts/run-ts.mjs src/worker.ts",
    "dev:realtime": "cross-env NODE_OPTIONS=--no-deprecation node scripts/run-ts.mjs src/realtime.ts",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "build:server": "node scripts/build-server.mjs",
    "start:worker": "cross-env NODE_OPTIONS=--no-deprecation node dist/server/worker.mjs",
    "start:realtime": "cross-env NODE_OPTIONS=--no-deprecation node dist/server/realtime.mjs",
    "migrate:prod": "cross-env NODE_OPTIONS=--no-deprecation node dist/server/migrate.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:int",
    "test": "pnpm test:int && pnpm test:e2e",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "services:up": "bash scripts/dev-services.sh up",
    "services:down": "bash scripts/dev-services.sh down",
    "release:prepare": "bash scripts/release.sh"
  },
  "dependencies": {
    "@c15t/nextjs": "2.3.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-multi-tenant": "3.90.2",
    "@payloadcms/plugin-stripe": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^6.3.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.8.1",
    "ioredis": "^5.6.1",
    "jose": "^6.2.12",
    "jsonata": "^2.2.2",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.0",
    "openid-client": "^6.8.8",
    "otplib": "^13.5.0",
    "payload": "3.90.2",
    "pino": "^9.6.0",
    "posthog-js": "1.435.8",
    "posthog-node": "5.55.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "rate-limiter-flexible": "^11.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "stripe": "10.17.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.22.4",
    "undici": "^8.11.2",
    "web-push": "^3.6.7",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^7.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
