# ---- Core ------------------------------------------------------------------
# development (default) | test | production. The Docker image sets production.
# NODE_ENV=development
# Long random string used to sign auth tokens. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public URL users reach Marmot at (used in emails, OIDC redirects, CORS).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Extra origins (comma-separated) allowed to call the API with the auth cookie (CORS + CSRF).
# ADDITIONAL_ORIGINS=https://status.example.com,https://ops.example.com
# web | worker | realtime | all  (compose sets this per service); probe = remote probe agent
MARMOT_ROLE=all
# Address the container's web server listens on (docker/entrypoint.sh); `::` for IPv6-only networks.
# BIND_HOST=0.0.0.0

# ---- Database (generic adapter) --------------------------------------------
# postgres (default) | mongodb | sqlite
DATABASE_ADAPTER=postgres
DATABASE_URL=postgres://marmot:marmot@localhost:5432/marmot
# DATABASE_ADAPTER=mongodb
# DATABASE_URL=mongodb://localhost:27017/marmot
# DATABASE_ADAPTER=sqlite
# DATABASE_URL=file:./data/marmot.db

# ---- Redis (BullMQ queues + socket.io pub/sub) -----------------------------
REDIS_URL=redis://localhost:6379
# Append ?family=0 when the Redis hostname resolves only to IPv6 (e.g. Railway private networking).

# ---- Realtime --------------------------------------------------------------
REALTIME_PORT=3001
# Leave empty when Caddy routes /socket.io to the realtime service on the same origin.
NEXT_PUBLIC_REALTIME_URL=

# ---- Storage (local disk by default; set S3_BUCKET to use S3-compatible storage)
UPLOADS_DIR=uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ---- Email (generic SMTP; unset SMTP_HOST logs mail to the console) --------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
EMAIL_FROM="Marmot <marmot@example.com>"
# Who may point an "Email (SMTP)" notification channel at the settings above:
# all | superadmin (instance superadmins only) | off (nobody).
NOTIFICATIONS_SERVER_SMTP=superadmin
# Messages per organization per hour through the server SMTP settings (test messages count); 0 = unlimited.
NOTIFICATIONS_SERVER_SMTP_RATE=60

# ---- Authentication --------------------------------------------------------
DISABLE_SIGNUP=false
# New self-service sign-ups confirm their address by email before they can create organizations,
# invite people or add notification channels (default of the instance setting; needs SMTP_HOST).
# REQUIRE_EMAIL_VERIFICATION=false
# Management API: requests (and writes) per minute per organization API key; 0 = unlimited.
# API_KEY_RATE_LIMIT=600
# API_KEY_WRITE_RATE_LIMIT=60
# Generic OIDC (discovery). All three required to enable the SSO button.
# OIDC_ISSUER_URL=https://auth.example.com/realms/main
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Single sign-on
# OIDC_AUTO_PROVISION=true
# OIDC_SCOPES=openid email profile
# Groups (docs/Single-Sign-On.md → Groups): claim, allow-list and group → organization role mapping.
# OIDC_GROUP_CLAIM=groups
# OIDC_ALLOWED_GROUPS=marmot-users,platform-admins
# OIDC_ROLE_MAPPING={"platform-admins": {"org": "acme", "role": "admin"}, "sre": {"org": "acme", "role": "member"}}
# OIDC_ROLE_MAPPING_REMOVE=false
# SSO-only mode: no password logins/sign-ups/resets; break-glass superadmin login at /login?local=1.
# OIDC_DISABLE_LOCAL_LOGIN=false
# OIDC_BREAK_GLASS=false
# Sign in with GitHub / Google. Each pair enables its button; register the callback URL
# ${NEXT_PUBLIC_SERVER_URL}/api/auth/sso/github/callback (resp. /google/callback) at the provider.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Monitoring ------------------------------------------------------------
# Daily aggregates are kept this many days (raw heartbeats 24h, minutely 24h, hourly 30d).
KEEP_DATA_PERIOD_DAYS=365
# Audit log rows (Settings → Audit log) are kept this many days; 0 keeps them forever.
AUDIT_LOG_RETENTION_DAYS=365
# Outbound webhooks (Settings → Webhooks): days the delivery log is kept (1–90), and how many
# deliveries in a row must fail (after their retries) before an endpoint is disabled (0 = never).
WEBHOOK_DELIVERY_RETENTION_DAYS=14
WEBHOOK_DISABLE_AFTER_FAILURES=5
# Parallel checks per worker process.
WORKER_CONCURRENCY=10
# On-demand checks ("Check now", the monitor form's "Test" and their API) per organization and minute.
ON_DEMAND_CHECKS_PER_MINUTE=30
# Self connectivity check: while the worker itself is offline, checks of external targets are held as
# PENDING "checker offline" beats (no notifications, no downtime). See docs/Configuration.md.
# CONNECTIVITY_CHECK_ENABLED=false
# CONNECTIVITY_CHECK_TARGETS=1.1.1.1:53, 8.8.8.8:53, https://www.google.com/generate_204
# CONNECTIVITY_CHECK_MODE=any
# CONNECTIVITY_CHECK_INTERVAL=30
# CONNECTIVITY_CHECK_TIMEOUT=5
# CONNECTIVITY_CHECK_NOTIFY_EMAIL=true
# CONNECTIVITY_CHECK_NOTIFICATION_ID=
# Probe locations (docs/Probe-Locations.md): seconds without contact before a location is offline,
# and requests per minute per location token (0 = unlimited).
# PROBE_OFFLINE_AFTER=180
# PROBE_RATE_LIMIT=600
# Probe agent only (MARMOT_ROLE=probe): the Marmot server and the location token. Nothing else is needed.
# MARMOT_URL=https://marmot.example.com
# MARMOT_PROBE_TOKEN=mp_...
# Allow Docker hosts of type "socket" (the worker's local Docker daemon, e.g. /var/run/docker.sock).
# Set to false on shared instances where organizations must not reach the host's Docker daemon.
DOCKER_SOCKET_ENABLED=true
# Set to 1 to skip BullMQ scheduler sync in the `monitors` hooks (tests without Redis).
# MARMOT_DISABLE_ENGINE_HOOKS=0
# Refuse monitor checks and notifications to private/loopback/link-local/container addresses.
# Turn on when untrusted people can create monitors (e.g. open sign-up). See docs/Security.md.
MONITOR_DENY_PRIVATE_ADDRESSES=false
# Comma-separated CIDRs that are always refused (wins over MONITOR_ALLOW_CIDRS).
# MONITOR_DENY_CIDRS=
# Comma-separated CIDRs exempt from the private-address deny list (internal subnets to monitor).
# MONITOR_ALLOW_CIDRS=

# Days a visitor stays signed in to a protected status page (password or email link; 1-365).
# STATUS_PAGE_SESSION_DAYS=30

# ---- Hosted instance ------------------------------------------------------
# Show a marketing landing page at / to signed-out visitors instead of redirecting to /login.
# Self-hosted installs leave this off.
LANDING_PAGE_ENABLED=false

# ---- Demo mode (docs/Demo-Mode.md) -----------------------------------------
# Self-resetting demo: seeds a dataset, simulates checks, sends nothing. EVERY RESET DELETES ALL DATA.
DEMO_MODE=false
# Minutes between two resets (15-10080).
# DEMO_RESET_INTERVAL_MINUTES=60
# Start although the database holds non-demo accounts (and wipe it). Never on a real install.
# DEMO_MODE_FORCE=false

# ---- Billing (scaffold; off on self-host, see docs/Billing.md) -------------
# Enforce plan limits and show the Billing settings tab. Self-hosted installs leave this off.
BILLING_ENABLED=false
# Registers the Stripe plugin (webhooks at /api/stripe/webhooks) and enables Checkout / Portal.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Reserved for a future Stripe Elements flow; hosted Checkout does not need it.
# STRIPE_PUBLISHABLE_KEY=

# ---- Telemetry (opt-in; nothing is sent unless a key is set) ---------------
# Setting the key enables PostHog analytics behind a cookie-consent banner and the aggregate
# server events; see docs/Telemetry.md for exactly what is collected. Both variables are inlined
# at build time (rebuild after changing them). The browser talks to the same-origin `/ph` proxy.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Caddy (docker compose only) -------------------------------------------
# DOMAIN=status.example.com
# ACME_EMAIL=you@example.com
# POSTGRES_PASSWORD=marmot
# Image tag for docker compose; defaults to the version the compose file was released with.
# MARMOT_VERSION=latest

LOG_LEVEL=info
