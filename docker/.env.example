# Marmot – docker compose configuration. Copy this file to `.env` next to docker-compose.yml.
#
# The bundled Postgres and Redis are wired up automatically; only the values below are usually needed.
# Every Marmot variable is documented in docs/Configuration.md and can be added here (the file is passed
# to the web, worker and realtime containers). The repository-root .env.example is for local development.

# ---- Required ----------------------------------------------------------------
# Long random string used to sign auth tokens. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public URL users reach Marmot at (emails, OIDC redirects, CORS). With DOMAIN set use https://<DOMAIN>.
NEXT_PUBLIC_SERVER_URL=http://localhost

# ---- HTTPS (Caddy) -----------------------------------------------------------
# Set DOMAIN to get automatic HTTPS; DNS must point at this host and ports 80/443 must be reachable.
# Leave it unset to serve plain HTTP on :80 (behind your own reverse proxy, or locally).
# DOMAIN=status.example.com
# ACME_EMAIL=you@example.com

# ---- Bundled services --------------------------------------------------------
POSTGRES_PASSWORD=marmot
# Image tag to run (see https://github.com/ThinkHumanDotDev/marmot/releases). Defaults to the version this
# compose file was released with; `latest` follows every final release, `0.1` follows 0.1.x patches.
# MARMOT_VERSION=latest

# ---- External database / Redis (optional) ------------------------------------
# Point Marmot at your own services instead of the bundled containers.
# DATABASE_ADAPTER=postgres
# DATABASE_URL=postgres://marmot:secret@db.example.com:5432/marmot
# REDIS_URL=redis://redis.example.com:6379
# Set to true to manage `payload migrate` yourself instead of running it when web starts.
# SKIP_MIGRATIONS=false

# ---- Storage (local volume by default; set S3_BUCKET for S3-compatible storage)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ---- Email (generic SMTP; unset SMTP_HOST logs mail to the console) ----------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
EMAIL_FROM="Marmot <marmot@example.com>"

# ---- Authentication ----------------------------------------------------------
DISABLE_SIGNUP=false
# OIDC_ISSUER_URL=https://auth.example.com/realms/main
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Single sign-on
# OIDC_AUTO_PROVISION=true

# ---- Monitoring --------------------------------------------------------------
KEEP_DATA_PERIOD_DAYS=365
LOG_LEVEL=info
